  m_TableData:
  - m_Id: 60370300928
    m_Localized: Unsere Spiele
    m_Metadata:
      m_Items: []
  - m_Id: 212850028544
    m_Localized: BESTES ANGEBOT
    m_Metadata:
      m_Items: []
  - m_Id: 243376173056
    m_Localized: Siehe {variable.AddsCountString}
    m_Metadata:
      m_Items:
      - rid: 2637936322217508927
  - m_Id: 246547066880
    m_Localized: "Alles kaufen f\xFCr {variable.IapPrice}"
    m_Metadata:
      m_Items:
      - rid: 2637936322217508927
  - m_Id: 630527209472
    m_Localized: Bewerten Sie uns!
    m_Metadata:
      m_Items: []
  - m_Id: 769526444032
    m_Localized: "Gef\xE4llt Ihnen das Spiel? Erz\xE4hlen Sie uns davon, indem Sie
      uns 5 Sterne geben"
    m_Metadata:
      m_Items: []
  - m_Id: 899394678784
    m_Localized: 1-4 Sterne
    m_Metadata:
      m_Items: []
  - m_Id: 979799486464
    m_Localized: 5 Sterne
    m_Metadata:
      m_Items: []
  - m_Id: 1253540737024
    m_Localized: Feedback
    m_Metadata:
      m_Items: []
  - m_Id: 1338081128448
    m_Localized: Absenden
    m_Metadata:
      m_Items: []
  - m_Id: 32401302073344
    m_Localized: "K\xE4ufe wiederherstellen"
    m_Metadata:
      m_Items: []
  - m_Id: 2149783214600192
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 6600179878309888
    m_Localized: Willkommen!
    m_Metadata:
      m_Items: []
  - m_Id: 6604195945361408
    m_Localized: Ich stimme zu
    m_Metadata:
      m_Items: []
  - m_Id: 6604771005411328
    m_Localized: "Durch Klicken des \"Ich stimme zu\" Buttons best\xE4tigst du, die
      <color=\"red\"><U><link=url1>Nutzervereinbarung</link></color></u> und Datenschutzregeln
      gelesen zu haben und <color=\"red\"><u><link=url2>ihnen zuzustimmen</link></u></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 8067465579442176
    m_Localized: 2 in 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067454279987200
    m_Localized: 3 in 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067910477656064
    m_Localized: Hauptlevel-Set
    m_Metadata:
      m_Items: []
  - m_Id: 8067913468194816
    m_Localized: Bonus-Level-Set
    m_Metadata:
      m_Items: []
  - m_Id: 8067916534231040
    m_Localized: Werbefreies Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 8084913120718848
    m_Localized: oder weiter spielen, um Werbung zu sehen
    m_Metadata:
      m_Items: []
  - m_Id: 14229703486976000
    m_Localized: Datenschutz
    m_Metadata:
      m_Items: []
  - m_Id: 14230229859545088
    m_Localized: Akzeptieren
    m_Metadata:
      m_Items: []
  - m_Id: 14230235123396608
    m_Localized: Ablehnen
    m_Metadata:
      m_Items: []
  - m_Id: 14230198976884736
    m_Localized: Datenschutz lesen
    m_Metadata:
      m_Items: []
  - m_Id: 50024699312345088
    m_Localized: Datenschutz
    m_Metadata:
      m_Items: []
  - m_Id: 52929870312902656
    m_Localized: Sprache
    m_Metadata:
      m_Items: []
  - m_Id: 53026157150474240
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 53026950922506240
    m_Localized: Die Anzeige konnte nicht geladen werden. Bitte versuche es erneut.
    m_Metadata:
      m_Items: []
  - m_Id: 55100405771800576
    m_Localized: Angebot starten
    m_Metadata:
      m_Items: []
  - m_Id: 55101171148394496
    m_Localized: Gemeinschaft
    m_Metadata:
      m_Items: []
  - m_Id: 55108694580531200
    m_Localized: Saison-Angebot
    m_Metadata:
      m_Items: []
  - m_Id: 55116735904354304
    m_Localized: Hauptangebot an levels
    m_Metadata:
      m_Items: []
  - m_Id: 55117798455775232
    m_Localized: Bonussatz von levels
    m_Metadata:
      m_Items: []
  - m_Id: 55129206589362176
    m_Localized: Leitfaden
    m_Metadata:
      m_Items: []
  - m_Id: 55129622584627200
    m_Localized: Werbefrei
    m_Metadata:
      m_Items: []
  - m_Id: 55129842961747968
    m_Localized: "Dieses Angebot ist nur f\xFCr 1 Mal g\xFCltig! Kaufen Sie jetzt,
      um den besten Preis zu erhalten, es wird nicht billiger sein."
    m_Metadata:
      m_Items: []
  - m_Id: 55130155336732672
    m_Localized: "Dieses Angebot ist nur f\xFCr 1 Minute g\xFCltig. Beeilen Sie sich
      und kaufen Sie zum Schn\xE4ppchenpreis!"
    m_Metadata:
      m_Items: []
  - m_Id: 55131019191390208
    m_Localized: "Es ist Verkaufszeit! Kaufen Sie den vollen Zugang mit einem gro\xDFen
      Rabatt."
    m_Metadata:
      m_Items: []
  - m_Id: 55131309017796608
    m_Localized: 'oder weiter spielen, um Werbung zu sehen:'
    m_Metadata:
      m_Items: []
  - m_Id: 76458769641897984
    m_Localized: Jetzt hast du Zugang zu allen Inhalten im Spiel und keine Werbung!
    m_Metadata:
      m_Items: []
  - m_Id: 76458771411894272
    m_Localized: Voller Zugang
    m_Metadata:
      m_Items: []
  - m_Id: 76458772779237376
    m_Localized: "Der Kauf schaltet den Zugang zu allen Inhalten im Spiel frei und
      entfernt alle l\xE4stige Werbung!"
    m_Metadata:
      m_Items: []
  - m_Id: 76458774305964032
    m_Localized: "Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
