      m_Items: []
  - m_Id: 6604771005411328
    m_Localized: "\u041D\u0430\u0436\u0430\u0432 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
      \"\u042F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D\", \u0432\u044B \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435
      \u0447\u0442\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u0438 \u0438
      \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B \u0441 <color=\"red\"><U><link=url1>\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
      \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435</link></color></u>
      \u0438 <color=\"red\"><u><link=url2>\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0430
      \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438</link></u></color>"
    m_Metadata:
      m_Items: []
