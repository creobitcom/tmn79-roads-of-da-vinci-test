  m_Name: EditionsLocalization_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: ec4bc888488df314b92f6b3736bf01d9, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2637936825708576770
  m_TableData:
  - m_Id: 60370300928
    m_Localized: "Na\u0161e hry"
    m_Metadata:
      m_Items: []
  - m_Id: 212850028544
    m_Localized: "NEJLEP\u0160\xCD NAB\xCDDKA"
    m_Metadata:
      m_Items: []
  - m_Id: 243376173056
    m_Localized: "Sledov\xE1n\xED {variable.AddsCountString}"
    m_Metadata:
      m_Items:
      - rid: 2637936825708576770
  - m_Id: 246547066880
    m_Localized: "Kupte si v\u0161e za {variable.IapPrice}"
    m_Metadata:
      m_Items:
      - rid: 2637936825708576770
  - m_Id: 630527209472
    m_Localized: "Ohodno\u0165te n\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 769526444032
    m_Localized: "L\xEDb\xED se v\xE1m hra? \u0158ekn\u011Bte n\xE1m o n\xED t\xEDm,
      \u017Ee n\xE1m d\xE1te 5 hv\u011Bzdi\u010Dek"
    m_Metadata:
      m_Items: []
  - m_Id: 899394678784
    m_Localized: "1-4 hv\u011Bzdi\u010Dky"
    m_Metadata:
      m_Items: []
  - m_Id: 979799486464
    m_Localized: "5 hv\u011Bzdi\u010Dek"
    m_Metadata:
      m_Items: []
  - m_Id: 1253540737024
    m_Localized: "Zp\u011Btn\xE1 vazba"
    m_Metadata:
      m_Items: []
  - m_Id: 1338081128448
    m_Localized: Odeslat
    m_Metadata:
      m_Items: []
  - m_Id: 8067465579442176
    m_Localized: 2 v 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067454279987200
    m_Localized: 3 v 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067910477656064
    m_Localized: "Sada hlavn\xED \xFArovn\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 8067913468194816
    m_Localized: "Bonusov\xE1 sada \xFArovn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 8067916534231040
    m_Localized: Hra bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 8084913120718848
    m_Localized: "nebo pokra\u010Dujte ve h\u0159e za sledov\xE1n\xED reklamy"
    m_Metadata:
      m_Items: []
  - m_Id: 32401302073344
    m_Localized: "Obnoven\xED n\xE1kup\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 6600179878309888
    m_Localized: "V\xEDtejte!"
    m_Metadata:
      m_Items: []
  - m_Id: 2149783214600192
    m_Localized: "Zav\u0159\xEDt\r"
    m_Metadata:
      m_Items: []
  - m_Id: 14230229859545088
    m_Localized: Akceptuj
    m_Metadata:
      m_Items: []
  - m_Id: 14230235123396608
    m_Localized: "Odrzu\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 14230198976884736
    m_Localized: "Przeczytaj Prywatno\u015B\u0107 danych"
    m_Metadata:
      m_Items: []
  - m_Id: 14229703486976000
    m_Localized: "Ochrana osobn\xEDch \xFAdaj\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 50024699312345088
    m_Localized: "Ochrana osobn\xEDch \xFAdaj\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 52929870312902656
    m_Localized: Jazyk
    m_Metadata:
      m_Items: []
  - m_Id: 53026157150474240
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 53026950922506240
    m_Localized: "Reklamu se nepoda\u0159ilo na\u010D\xEDst. Pros\xEDm zkuste to
      znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 55100405771800576
    m_Localized: "Zah\xE1jen\xED nab\xEDdky"
    m_Metadata:
      m_Items: []
  - m_Id: 55101171148394496
    m_Localized: "Spole\u010Denstv\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 55108694580531200
    m_Localized: "Sez\xF3nn\xED nab\xEDdka"
    m_Metadata:
      m_Items: []
  - m_Id: 55116735904354304
    m_Localized: "Hlavn\xED sada \xFArovn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 55117798455775232
    m_Localized: "Bonusov\xE1 sada \xFArovn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 55129206589362176
    m_Localized: "Pr\u016Fvodce"
    m_Metadata:
      m_Items: []
  - m_Id: 55129622584627200
    m_Localized: Bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 55129842961747968
    m_Localized: "Tato nab\xEDdka plat\xED pouze jednou! Kupte si nyn\xED, abyste
      z\xEDskali nejlep\u0161\xED cenu, levn\u011Bj\u0161\xED u\u017E nebude."
    m_Metadata:
      m_Items: []
  - m_Id: 55130155336732672
    m_Localized: "Tato nab\xEDdka plat\xED pouze 1 minutu. Posp\u011B\u0161te si
      s n\xE1kupem za v\xFDhodnou cenu!"
    m_Metadata:
      m_Items: []
  - m_Id: 55131019191390208
    m_Localized: "Je \u010Das na v\xFDprodej! Kupte si pln\xFD p\u0159\xEDstup s
      velkou slevou."
    m_Metadata:
      m_Items: []
  - m_Id: 55131309017796608
    m_Localized: "nebo pokra\u010Dujte ve h\u0159e za sledov\xE1n\xED reklamy:"
    m_Metadata:
      m_Items: []
  - m_Id: 76458769641897984
    m_Localized: "Nyn\xED m\xE1te p\u0159\xEDstup k ve\u0161ker\xE9mu obsahu ve h\u0159e
      a bez reklam!"
    m_Metadata:
      m_Items: []
  - m_Id: 76458771411894272
    m_Localized: "Pln\xFD p\u0159\xEDstup"
    m_Metadata:
      m_Items: []
  - m_Id: 76458772779237376
    m_Localized: "Zakoupen\xEDm z\xEDsk\xE1te p\u0159\xEDstup k ve\u0161ker\xE9mu
      obsahu hry a odstran\xEDte v\u0161echny otravn\xE9 reklamy!"
    m_Metadata:
      m_Items: []
  - m_Id: 76458774305964032
    m_Localized: Gratulujeme!
    m_Metadata:
      m_Items: []
  - m_Id: 154878009131577344
    m_Localized: 
    m_Metadata:
      m_Items: []
