  m_TableData:
  - m_Id: 60370300928
    m_Localized: Nos jeux
    m_Metadata:
      m_Items: []
  - m_Id: 212850028544
    m_Localized: MEILLEURE OFFRE
    m_Metadata:
      m_Items: []
  - m_Id: 243376173056
    m_Localized: Regarder {variable.AddsCountString}
    m_Metadata:
      m_Items:
      - rid: 2637936322217508926
  - m_Id: 246547066880
    m_Localized: Tout acheter pour {variable.IapPrice}
    m_Metadata:
      m_Items:
      - rid: 2637936322217508926
  - m_Id: 630527209472
    m_Localized: Notez-nous !
    m_Metadata:
      m_Items: []
  - m_Id: 769526444032
    m_Localized: "Vous aimez ce jeu ? Dites-le en nous donnant 5 \xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 899394678784
    m_Localized: "1-4 \xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 979799486464
    m_Localized: "5 \xE9toiles"
    m_Metadata:
      m_Items: []
  - m_Id: 1253540737024
    m_Localized: Commentaires
    m_Metadata:
      m_Items: []
  - m_Id: 1338081128448
    m_Localized: Envoyer
    m_Metadata:
      m_Items: []
  - m_Id: 32401302073344
    m_Localized: Restaurer les achats
    m_Metadata:
      m_Items: []
  - m_Id: 2149783214600192
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 6600179878309888
    m_Localized: Bienvenue!
    m_Metadata:
      m_Items: []
  - m_Id: 6604195945361408
    m_Localized: J'accepte
    m_Metadata:
      m_Items: []
  - m_Id: 6604771005411328
    m_Localized: "En cliquant sur le bouton \"J'accepte\", vous reconnaissez avoir
      lu et accept\xE9 les <color=\"red\"><U><link=url1>Conditions d'utilisation</link></color></u>
      et la <color=\"red\"><u><link=url2>Politique de confidentialit\xE9</link></u></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 8067465579442176
    m_Localized: 2 en 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067454279987200
    m_Localized: 3 en 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067910477656064
    m_Localized: Niveau principal
    m_Metadata:
      m_Items: []
  - m_Id: 8067913468194816
    m_Localized: Jeu de niveaux bonus
    m_Metadata:
      m_Items: []
  - m_Id: 8067916534231040
    m_Localized: "Jeu sans publicit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 8084913120718848
    m_Localized: "ou continuer \xE0 jouer pour voir des publicit\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 14229703486976000
    m_Localized: "Confidentialit\xE9 des donn\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 14230229859545088
    m_Localized: Accepter
    m_Metadata:
      m_Items: []
  - m_Id: 14230235123396608
    m_Localized: Rejeter
    m_Metadata:
      m_Items: []
  - m_Id: 14230198976884736
    m_Localized: "Lire la confidentialit\xE9 des donn\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 50024699312345088
    m_Localized: "Confidentialit\xE9 des donn\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 52929870312902656
    m_Localized: Langue
    m_Metadata:
      m_Items: []
  - m_Id: 53026157150474240
    m_Localized: D'accord
    m_Metadata:
      m_Items: []
  - m_Id: 53026950922506240
    m_Localized: "\xC9chec du chargement de l'annonce. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 55100405771800576
    m_Localized: "Offre de d\xE9part"
    m_Metadata:
      m_Items: []
  - m_Id: 55101171148394496
    m_Localized: "Communaut\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 55108694580531200
    m_Localized: Offre de saison
    m_Metadata:
      m_Items: []
  - m_Id: 55116735904354304
    m_Localized: Ensemble principal de niveaux
    m_Metadata:
      m_Items: []
  - m_Id: 55117798455775232
    m_Localized: Niveaux bonus
    m_Metadata:
      m_Items: []
  - m_Id: 55129206589362176
    m_Localized: Guide
    m_Metadata:
      m_Items: []
  - m_Id: 55129622584627200
    m_Localized: "Sans publicit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 55129842961747968
    m_Localized: Cette offre n'est valable qu'une seule fois ! Achetez maintenant
      pour obtenir le meilleur prix, il n'y aura pas moins cher.
    m_Metadata:
      m_Items: []
  - m_Id: 55130155336732672
    m_Localized: "Cette offre est valable pendant 1 minute seulement. D\xE9p\xEAchez-vous
      d'acheter \xE0 un prix avantageux!"
    m_Metadata:
      m_Items: []
  - m_Id: 55131019191390208
    m_Localized: "C'est l'heure des soldes! Achetez l'acc\xE8s complet \xE0 un prix
      r\xE9duit."
    m_Metadata:
      m_Items: []
  - m_Id: 55131309017796608
    m_Localized: "ou continuer \xE0 jouer pour voir la publicit\xE9:"
    m_Metadata:
      m_Items: []
  - m_Id: 76458769641897984
    m_Localized: "Vous avez d\xE9sormais acc\xE8s \xE0 tout le contenu du jeu, sans
      publicit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 76458771411894272
    m_Localized: "Acc\xE8s complet"
    m_Metadata:
      m_Items: []
  - m_Id: 76458772779237376
    m_Localized: "L'achat d\xE9bloque l'acc\xE8s \xE0 tout le contenu du jeu et supprime
      toutes les publicit\xE9s g\xEAnantes !"
    m_Metadata:
      m_Items: []
  - m_Id: 76458774305964032
    m_Localized: "F\xE9licitations !"
    m_Metadata:
      m_Items: []
