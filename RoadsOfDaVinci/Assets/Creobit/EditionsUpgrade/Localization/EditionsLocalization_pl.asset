  m_TableData:
  - m_Id: 60370300928
    m_Localized: Nasze gry
    m_Metadata:
      m_Items: []
  - m_Id: 212850028544
    m_Localized: NAJLEPSZA OFERTA
    m_Metadata:
      m_Items: []
  - m_Id: 243376173056
    m_Localized: "Ogl\u0105daj {variable.AddsCountString}"
    m_Metadata:
      m_Items:
      - rid: 2637936825708576771
  - m_Id: 246547066880
    m_Localized: Kup wszystko za {variable.IapPrice}
    m_Metadata:
      m_Items:
      - rid: 2637936825708576771
  - m_Id: 630527209472
    m_Localized: "Oce\u0144 nas!"
    m_Metadata:
      m_Items: []
  - m_Id: 769526444032
    m_Localized: "Podoba ci si\u0119 gra? Opowiedz o tym, daj\u0105c nam 5 gwiazdek"
    m_Metadata:
      m_Items: []
  - m_Id: 899394678784
    m_Localized: 1-4 gwiazdki
    m_Metadata:
      m_Items: []
  - m_Id: 979799486464
    m_Localized: 5 gwiazdek
    m_Metadata:
      m_Items: []
  - m_Id: 1253540737024
    m_Localized: Opinia
    m_Metadata:
      m_Items: []
  - m_Id: 1338081128448
    m_Localized: "Wy\u015Blij"
    m_Metadata:
      m_Items: []
  - m_Id: 8067454279987200
    m_Localized: 3 w 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067465579442176
    m_Localized: 2 w 1
    m_Metadata:
      m_Items: []
  - m_Id: 8067910477656064
    m_Localized: "G\u0142\xF3wny zestaw poziom\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 8067913468194816
    m_Localized: "Dodatkowy zestaw poziom\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 8067916534231040
    m_Localized: Gra bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 8084913120718848
    m_Localized: "lub graj dalej, aby ogl\u0105da\u0107 reklamy"
    m_Metadata:
      m_Items: []
  - m_Id: 32401302073344
    m_Localized: "Przywr\xF3\u0107 zakupy"
    m_Metadata:
      m_Items: []
  - m_Id: 6600179878309888
    m_Localized: Witamy!
    m_Metadata:
      m_Items: []
  - m_Id: 2149783214600192
    m_Localized: Zamknij
    m_Metadata:
      m_Items: []
  - m_Id: 14230235123396608
    m_Localized: "Odm\xEDtnout"
    m_Metadata:
      m_Items: []
  - m_Id: 14230229859545088
    m_Localized: "P\u0159ijmout"
    m_Metadata:
      m_Items: []
  - m_Id: 14230198976884736
    m_Localized: "P\u0159e\u010Dt\u011Bte si o ochran\u011B osobn\xEDch \xFAdaj\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 14229703486976000
    m_Localized: "Prywatno\u015B\u0107 danych"
    m_Metadata:
      m_Items: []
  - m_Id: 50024699312345088
    m_Localized: "Prywatno\u015B\u0107 danych"
    m_Metadata:
      m_Items: []
  - m_Id: 52929870312902656
    m_Localized: "J\u0119zyk"
    m_Metadata:
      m_Items: []
  - m_Id: 53026157150474240
    m_Localized: Ok
    m_Metadata:
      m_Items: []
  - m_Id: 53026950922506240
    m_Localized: "Nie uda\u0142o si\u0119 za\u0142adowa\u0107 reklamy. Prosz\u0119
      spr\xF3buj ponownie."
    m_Metadata:
      m_Items: []
  - m_Id: 55100405771800576
    m_Localized: "Oferta pocz\u0105tkowa"
    m_Metadata:
      m_Items: []
  - m_Id: 55101171148394496
    m_Localized: "Wsp\xF3lnota"
    m_Metadata:
      m_Items: []
  - m_Id: 55108694580531200
    m_Localized: Oferta sezonowa
    m_Metadata:
      m_Items: []
  - m_Id: 55116735904354304
    m_Localized: "G\u0142\xF3wny zestaw poziom\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 55117798455775232
    m_Localized: "Dodatkowy zestaw poziom\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 55129206589362176
    m_Localized: Przewodnik
    m_Metadata:
      m_Items: []
  - m_Id: 55129622584627200
    m_Localized: Bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 55129842961747968
    m_Localized: "Ta oferta jest wa\u017Cna tylko 1 raz! Kup teraz, aby uzyska\u0107
      najlepsz\u0105 cen\u0119, taniej nie b\u0119dzie."
    m_Metadata:
      m_Items: []
  - m_Id: 55130155336732672
    m_Localized: "Ta oferta jest wa\u017Cna tylko przez 1 minut\u0119. Pospiesz si\u0119,
      aby kupi\u0107 w okazyjnej cenie!"
    m_Metadata:
      m_Items: []
  - m_Id: 55131019191390208
    m_Localized: "Nadszed\u0142 czas wyprzeda\u017Cy! Kup pe\u0142ny dost\u0119p
      z du\u017C\u0105 zni\u017Ck\u0105. "
    m_Metadata:
      m_Items: []
  - m_Id: 55131309017796608
    m_Localized: "lub graj dalej, aby ogl\u0105da\u0107 reklamy:"
    m_Metadata:
      m_Items: []
  - m_Id: 76458769641897984
    m_Localized: "Teraz masz dost\u0119p do ca\u0142ej zawarto\u015Bci gry bez reklam!"
    m_Metadata:
      m_Items: []
  - m_Id: 76458771411894272
    m_Localized: "Pe\u0142ny dost\u0119p"
    m_Metadata:
      m_Items: []
  - m_Id: 76458772779237376
    m_Localized: "Zakup odblokuje dost\u0119p do ca\u0142ej zawarto\u015Bci gry i
      usunie wszystkie irytuj\u0105ce reklamy!"
    m_Metadata:
      m_Items: []
  - m_Id: 76458774305964032
    m_Localized: Gratulacje!
    m_Metadata:
      m_Items: []
