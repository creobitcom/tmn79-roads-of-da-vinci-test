      m_Calls: []
  m_text: "\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u0446\u0430 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0430
    \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u043B\u0435\u0433\u0435\u043D\u0434\u044B:
    \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0430 \u0422\u0440\u043E\u043B\u043B\u0435\u0439
    \u0440\u043E\u0441\u0442\u043E\u043C \u0441 \u0442\u0438\u0442\u0430\u043D\u043E\u0432
    \u2013 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u0439 \u043C\u0438\u0440\u0430,
    \u0430 \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0430 \u0413\u043D\u043E\u043C\u043E\u0432
    \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u044F\u0432\u0438\u043B\u0430:
    \"\u041D\u0430 \u041B\u0443\u043D\u0435 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
    \u043E\u0442\u0432\u0435\u0442\u044B, \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E
    \u0432\u0438\u0434\u0438\u0442 \u0441\u0443\u0434\u044C\u0431\u044B \u0432\u0441\u0435\u0445
    \u043D\u0430\u0440\u043E\u0434\u043E\u0432\"!"
  m_isRightToLeft: 0
