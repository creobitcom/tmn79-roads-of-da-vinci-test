      \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u0437\u0432\u0435\u0437\u0434\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0430\u0442\u044C
      \u0441\u0442\u0430\u0442\u0443\u0438 \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
      \u0431\u043E\u043D\u0443\u0441\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163936
    m_Localized: "\u042D\u0442\u043E \u0442\u0432\u043E\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044B! "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163937
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E,
      \u043D\u0435 \u043C\u0435\u0434\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163938
    m_Localized: "\u041A\u043B\u0438\u043A\u043D\u0438 \u043D\u0430 \u0442\u043E\u0447\u043A\u0443
      \u043E\u0442\u0434\u044B\u0445\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F! "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163939
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043E\u0442\u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0430\u043B\u0442\u0430\u0440\u044C \u0438 \u043F\u043E\u0447\u0442\u0438\u0442\u044C
      \u0431\u043E\u0433\u043E\u0432, \u043D\u0443\u0436\u043D\u044B \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u044B. \u0421\u043E\u0431\u0435\u0440\u0438
      \u0438\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163940
    m_Localized: "\u0421\u043A\u043E\u0440\u0435\u0435, \u0434\u0430\u0439 \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443
      \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163941
    m_Localized: "\u041F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u043C\u043E\u0436\u043D\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163942
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u0434\u043C\u043E\u0433\u0430:
      \u0443\u043B\u0443\u0447\u0448\u0430\u0439 \u043B\u0430\u0433\u0435\u0440\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u043E\u0434\u043C\u0430\u0441\u0442\u0435\u0440\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163943
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u0435\u0442\u0438\u0442\u044C
      \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E, \u043D\u0430\u0434\u043E
      \u0441\u0442\u0430\u0432\u044C \u0444\u0430\u043A\u0435\u043B\u044B \u0432
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u0435\u043B\u0438.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0434\u0431\u0435\u0440\u0451\u043C
      \u043F\u0435\u0440\u0432\u044B\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163944
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0422\u0435\u043F\u0435\u0440\u044C
      \u043F\u043E\u0441\u0442\u0430\u0432\u044C \u0444\u0430\u043A\u0435\u043B \u0432
      \u043D\u043E\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163945
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043E\u0448\u0438\u0431\u0441\u044F
      \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0435 \u0442\u043E, \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0441\u044F!
      \u0412\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u044D\u0442\u043E
      \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C \u0438 \u043D\u0430\u0447\u0430\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163946
    m_Localized: "\u041A\u043B\u0438\u043A\u043D\u0438 \u043D\u0430 \u0444\u043E\u043D\u0430\u0440\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
      \u0440\u0430\u0434\u0438\u0443\u0441 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u044F
      \u0441\u0432\u043E\u0435\u0433\u043E \u0444\u0430\u043A\u0435\u043B\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163947
    m_Localized: "\u0417\u0430\u0436\u0433\u0438 \u0444\u043E\u043D\u0430\u0440\u044C,
      \u043A\u043B\u0438\u043A\u043D\u0443\u0432 \u043D\u0430 \u043D\u0435\u0433\u043E.
      \u041D\u043E \u043F\u043E\u043C\u043D\u0438: \u043E\u043D \u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u0442\u0443\u0445\u043D\u0443\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163948
    m_Localized: "\u041D\u0443\u0436\u043D\u0430 \u043A\u0440\u0430\u0441\u043A\u0430!
      \u041A\u043B\u0438\u043A\u043D\u0438 \u043D\u0430 \u0444\u0430\u0431\u0440\u0438\u043A\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0435\u0451 \u0438\u0437 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163949
    m_Localized: "\u041B\u0443\u0447\u043E\u043C \u0441\u0432\u0435\u0442\u0430 \u043C\u043E\u0436\u043D\u043E
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439!
      \u041F\u043E\u0432\u0435\u0440\u043D\u0438 \u0437\u0435\u0440\u043A\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039687163950
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0430!
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
