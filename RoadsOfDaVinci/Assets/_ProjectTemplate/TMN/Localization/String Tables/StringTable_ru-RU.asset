  - m_Id: 6801039678775337
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0413\u0435\u0440\u043C\u0435\u0441\u0430 \u043A
      \u0441\u0442\u0430\u0442\u0443\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775338
    m_Localized: "\u041D\u0430 \u0440\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775339
    m_Localized: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435
      \u043E\u0441\u0442\u0440\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
      \u044D\u0442\u0443 \u0441\u0442\u0430\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775340
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435:"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775341
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775342
    m_Localized: Muse - Time Is Running Out
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775343
    m_Localized: Muse - Supermassive Black Hole
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775344
    m_Localized: "\u041D\u0435\u0442 \u0441\u0432\u044F\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775345
    m_Localized: "\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0435\u0449\u0435 \u0440\u0430\u0437 \u0438\u043B\u0438 \u0441\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C
      \u0441 \u043D\u0430\u0448\u0435\u0439 \u0441\u043B\u0443\u0436\u0431\u043E\u0439
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775346
    m_Localized: "\u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775347
    m_Localized: "\u0411\u043E\u0433\u0438, \u043A\u0430\u043A \u0442\u0435\u043C\u043D\u043E!
      \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0436\u0435 \u043F\u043E\u043B\u0434\u0435\u043D\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775348
    m_Localized: "\u041D\u0435\u043F\u0440\u043E\u0433\u043B\u044F\u0434\u043D\u0430\u044F
      \u0442\u044C\u043C\u0430? \u041D\u043E \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0432\u0435\u0442\u0430 \u0435\u0449\u0451 \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043B\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775349
    m_Localized: "\u041A\u0443\u0434\u0430 \u0434\u0435\u043B\u043E\u0441\u044C \u0441\u043E\u043B\u043D\u0446\u0435?!
      \u041A\u0443\u0434\u0430 \u0434\u0435\u043B\u043E\u0441\u044C \u043D\u0435\u0431\u043E?!
      \u041A\u0443\u0434\u0430 \u0434\u0435\u043B\u0441\u044F \u044F?! \u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775350
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0415\u043B\u0435\u043D\u0430
      \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775351
    m_Localized: "\u0411\u0410\u0425!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775352
    m_Localized: "\u0427\u0442\u043E \u0442\u0430\u043C \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775353
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E-\u0442\u043E
      \u0443\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775354
    m_Localized: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u043E
      \u0431\u044B\u043B\u0430 \u043C\u043E\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775355
    m_Localized: "\u0417\u0432\u0443\u043A \u0431\u044B\u043B \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0442\u0438\u0445\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775356
    m_Localized: "\u042D\u0442\u043E \u043F\u0442\u0438\u0446\u0430? \u042D\u0442\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775357
    m_Localized: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u044D\u0442\u043E \u0410\u0445\u0438\u043B\u043B\u0435\u0441. \u0422\u043E\u0447\u043D\u043E,
      \u0443 \u043D\u0435\u0433\u043E \u0442\u0430\u043A\u0430\u044F \u0436\u0435
      \u0448\u0435\u0432\u0435\u043B\u044E\u0440\u0430 \u0431\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775358
    m_Localized: "\u042D\u0442\u043E \u0410\u043F\u043E\u043B\u043B\u043E\u043D.
      \u042F \u0432\u044B\u0441\u0435\u043A \u0435\u0433\u043E \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u044B\u0435
      \u041F\u0438\u0444\u0438\u0439\u0441\u043A\u0438\u0435 \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775359
    m_Localized: "\u0410\u043F\u043E\u043B\u043B\u043E\u043D? \u042D\u0442\u043E
      \u043D\u0435 \u0442\u043E\u0442, \u0447\u0442\u043E \u0437\u0430 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775360
    m_Localized: "\u041E\u043D \u0441\u0430\u043C\u044B\u0439. \u041B\u044E\u0434\u0438
      \u043C\u043E\u043B\u0432\u0438\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u0441\u043E\u043B\u043D\u0446\u0435 \u043F\u043E \u0432\u0441\u0435\u0439
      \u0413\u0440\u0435\u0446\u0438\u0438 \u043F\u0440\u043E\u043F\u0430\u043B\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775361
    m_Localized: "\u0415\u043B\u0435\u043D\u0430! \u0422\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775362
    m_Localized: "\u042F \u043F\u0440\u0438\u0448\u043B\u0430 \u0437\u0430 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430\u043C\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0442\u0430\u043B\u043E
      \u0442\u0435\u043C\u043D\u043E, \u043A\u0430\u043A \u0432 \u0426\u0430\u0440\u0441\u0442\u0432\u0435
      \u0410\u0438\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775363
    m_Localized: "\u041E, \u041F\u043E\u043B\u043B\u0443\u043A\u0441, \u0447\u0442\u043E
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442? \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u043D\u0435\u0431\u043E \u0440\u0443\u0448\u0438\u0442\u0441\u044F \u043D\u0430\u043C
      \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775364
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u043C\u0438\u043B\u0430\u044F.
      \u041F\u043E\u043A\u0430 \u0447\u0442\u043E \u0440\u0443\u0448\u0430\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0438 \u0441\u0442\u0430\u0442\u0443\u0438,
      \u0430 \u044D\u0442\u043E \u043D\u0435 \u0441\u0430\u043C\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775365
    m_Localized: "\u041D\u043E \u0441\u043E\u043B\u043D\u0446\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775366
    m_Localized: "\u042F \u0441\u0430\u043C \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442.
      \u041D\u043E \u0437\u043D\u0430\u044E, \u0443 \u043A\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775367
    m_Localized: "\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u041E\u0440\u0430\u043A\u0443\u043B
      \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775368
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E! \u041E\u043D \u0436\u0435
      \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B \u0437\u0430\u0441\u0443\u0445\u0443
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0433\u043E\u0434\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775369
    m_Localized: "\u041D\u043E \u0442\u043E\u0433\u0434\u0430, \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442,
      \u043F\u0440\u043E\u043B\u0438\u043B\u043E\u0441\u044C \u043C\u043D\u043E\u0433\u043E
      \u0434\u043E\u0436\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775370
    m_Localized: "\u0415\u043C\u0443 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0443\u0436\u0435\u043D
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0448\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775371
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u041E\u0440\u0430\u043A\u0443\u043B
      \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043B \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435
      \u043B\u0435\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775372
    m_Localized: "\u041A\u043E\u0433\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775373
    m_Localized: "\u0414\u0430 \u0432\u0447\u0435\u0440\u0430, \u043D\u0430 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u043F\u043B\u043E\u0449\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775374
    m_Localized: "\u0425\u043C, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0441\u0438\u043D\u043E\u043F\u0442\u0438\u043A \u0438\u0437 \u043D\u0435\u0433\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435\u0432\u0430\u0436\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775375
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0440\u044F
      \u044F \u043A\u0443\u043F\u0438\u043B \u043D\u043E\u0432\u044B\u0435 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0435
      \u0447\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775376
    m_Localized: "\u041E\u0440\u0430\u043A\u0443\u043B! \u042F \u0442\u0435\u0431\u044F
      \u043F\u043E\u0432\u0441\u044E\u0434\u0443 \u0438\u0449\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775377
    m_Localized: "\u0410, \u044E\u043D\u044B\u0439 \u041F\u043E\u043B\u043B\u0443\u043A\u0441,
      \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439. \u041A\u0430\u043A
      \u0434\u0435\u043B\u0430 \u0443 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u0415\u043B\u0435\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775378
    m_Localized: "\u041D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043F\u0440\u043E\u0432\u0438\u0434\u0435\u0446! \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u0431\u043E\u0433\u0430\u043C\u0438?
      \u041C\u043D\u0435 \u0441\u0440\u043E\u0447\u043D\u043E \u043D\u0430\u0434\u043E
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775379
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E! \u042F \u0436\u0435
      \u043E\u0440\u0430\u043A\u0443\u043B! \u042D\u0442\u043E \u043C\u043E\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430 - \u0431\u044B\u0442\u044C \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0435\u0439
      \u043D\u0438\u0442\u044C\u044E \u043C\u0435\u0436\u0434\u0443 \u043C\u0438\u0440\u043E\u043C
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0445 \u0438 \u0441\u043E\u043D\u043C\u043E\u043C
      \u043C\u043E\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775380
    m_Localized: "...\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043D\u0430\u043C\u0438 \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775381
    m_Localized: "\u0412\u043E\u0442 \u043C\u043E\u043B\u043E\u0434\u0451\u0436\u044C
      \u043F\u043E\u0448\u043B\u0430, \u043D\u0438 \u043A\u0430\u043F\u043B\u0438
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F. \u041B\u0430\u0434\u043D\u043E,
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0441\u0435\u0430\u043D\u0441 \u0441\u0432\u044F\u0437\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775382
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775383
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E. \u0412\u0441\u0451
      \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442
      \u043D\u0430 \"\u0441\u043B\u0443\u0436\u0431\u0443 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438\",
      \u0438 \u043C\u0443\u0437\u044B\u043A\u0430 \u0438\u0433\u0440\u0430\u0435\u0442,
      \u043D\u0430\u0437\u043E\u0439\u043B\u0438\u0432\u0430\u044F \u0442\u0430\u043A\u0430\u044F...
      \u041F\u043E\u0441\u0442\u043E\u0439, \u0434\u0430 \u044D\u0442\u043E \u0436\u0435
      \u043F\u0435\u0441\u043D\u044C \u041A\u0430\u043B\u043B\u0438\u043E\u043F\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775384
    m_Localized: "\u0418 \u0447\u0442\u043E \u0436\u0435 \u044D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775385
    m_Localized: "\u0427\u0442\u043E \u041B\u0443\u0447\u0435\u0437\u0430\u0440\u043D\u044B\u0439
      \u043D\u0430\u043C \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u0442.
      \u0421\u0438\u0433\u043D\u0430\u043B \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0430\u0431\u044B\u0439,
      \u043A\u0430\u043C\u0435\u043D\u044C \u043A\u0440\u0443\u0433\u043E\u043C...
      \u041D\u0430\u0434\u043E \u0438\u0434\u0442\u0438 \u0432 \u0445\u0440\u0430\u043C
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430 - \u044D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u043C\u044B \u0443\u0441\u043B\u044B\u0448\u0438\u043C
      \u0435\u0433\u043E \u043A\u0438\u0444\u0430\u0440\u0443... \u0442\u043E \u0435\u0441\u0442\u044C
      \u0433\u0434\u0435 \u043D\u0430\u0441 \u0443\u0441\u043B\u044B\u0448\u0430\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775386
    m_Localized: "\u0425\u0440\u0430\u043C \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435
      \u044D\u0442\u043E\u0439 \u0433\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775387
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C
      \u0442\u0435\u0440\u044F\u0442\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775388
    m_Localized: "\u0418\u0434\u0438 \u0432\u043F\u0435\u0440\u0451\u0434, \u044F
      \u0443\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440,
      \u043A\u0430\u043A \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775389
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435! \u041C\u043E\u0439
      \u0431\u0440\u0430\u0442 \u0443\u043F\u0430\u043B \u0438 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B
      \u043D\u043E\u0433\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775390
    m_Localized: "\u041C\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u043E\u043C\u043E\u0447\u044C!
      \u041D\u043E \u043A\u0430\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775391
    m_Localized: "\u0412\u043E\u0442 \u0438 \u043A\u0443\u0440\u0441\u044B \"\u0410\u0441\u043A\u043B\u0435\u043F\u0438\u0439
      \u0434\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0438\u0445\"
      \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u043B\u0438\u0441\u044C! \u041F\u043E\u043B\u043B\u0443\u043A\u0441,
      \u043E\u0442\u0432\u0435\u0434\u0438 \u043C\u0435\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775392
    m_Localized: "\u041A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C! \u042F...
      \u0433\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775393
    m_Localized: "\u0414\u0435\u0440\u0436\u0438\u0441\u044C, \u043C\u044B \u0443\u0436\u0435
      \u0438\u0434\u0451\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775394
    m_Localized: "\u041E\u0445, \u043C\u043E\u044F \u043B\u043E\u0434\u044B\u0436\u043A\u0430.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435! \u041F\u0440\u0438\u043C\u0438
      \u044D\u0442\u043E \u0432 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C,
      \u0438 \u0445\u0440\u0430\u043D\u0438 \u0442\u0435\u0431\u044F \u0431\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775395
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C \u0435\u0449\u0451 \u0440\u0430\u043D\u0435\u043D\u044B\u0435,
      \u043D\u0430\u0434\u043E \u0437\u0430\u043F\u0430\u0441\u0442\u0438\u0441\u044C
      \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u043C\u0438 \u0442\u0440\u0430\u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775396
    m_Localized: "\u0413\u0435\u0444\u0435\u0441\u0442 \u0432\u0441\u0435\u043C\u043E\u0433\u0443\u0449\u0438\u0439,
      \u043C\u043E\u0441\u0442 \u0441\u043B\u043E\u043C\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775397
    m_Localized: " \u041F\u043E\u0433\u043E\u0434\u0438 \u043E\u0442\u0447\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F!
      \u041C\u043E\u0436\u0435\u0442, \u043D\u0430\u043C \u0443\u0434\u0430\u0441\u0442\u0441\u044F
      \u0435\u0433\u043E \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775398
    m_Localized: " \u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u0440\u0430\u043D\u044C\u0448\u0435
      \u043F\u0443\u0442\u044C \u0434\u043E \u0445\u0440\u0430\u043C\u0430 \u043C\u043D\u0435
      \u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043A\u043E\u0440\u043E\u0447\u0435.
      \u042F \u0442\u0430\u043A \u0434\u043E \u0410\u0444\u0438\u043D \u0434\u043E\u0439\u0434\u0443
      \u043D\u0435\u043D\u0430\u0440\u043E\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775399
    m_Localized: "\u0421\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0430\u043C,
      \u0445\u0440\u0430\u043C \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775400
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0417\u043D\u0430\u0447\u0438\u0442,
      \u043D\u0435 \u0431\u0443\u0434\u0435\u043C \u0442\u0435\u0440\u044F\u0442\u044C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775401
    m_Localized: "\u041E\u0440\u0430\u043A\u0443\u043B? \u041A\u0430\u043A \u0432\u044B
      \u0441\u044E\u0434\u0430 \u043F\u043E\u043F\u0430\u043B\u0438?! \u041C\u043E\u0441\u0442
      \u0436\u0435 \u0431\u044B\u043B \u0441\u043B\u043E\u043C\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775402
    m_Localized: "\u0422\u044B \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F
      \u0432\u043E \u043C\u043D\u0435? \u0421\u0442\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u0436\u0438\u0432\u0443,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0442\u0435\u0431\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775403
    m_Localized: "\u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443 \u0436\u0435
      \u0442\u044B \u0441\u0440\u0430\u0437\u0443 \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u043A\u0430\u043A \u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0443\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775404
    m_Localized: "\u041D\u0435 \u0432\u0430\u0436\u043D\u043E, \u0443 \u043D\u0430\u0441
      \u0435\u0441\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \u043D\u0430\u0441\u0443\u0449\u043D\u044B\u0435
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B! \u0418\u0434\u0451\u043C!
      \u0412\u043E\u0437\u0434\u0430\u0434\u0438\u043C \u0434\u043E\u043B\u0436\u043D\u043E\u0435
      \u0415\u0433\u043E \u0421\u0438\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775405
    m_Localized: "\u0421\u0432\u044F\u0442\u0430\u044F \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u0430\u044F
      \u0432\u0435\u0442\u0432\u044C! \u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0451
      \u0432 \u0442\u0430\u043A\u043E\u043C \u0437\u0430\u043F\u0443\u0441\u0442\u0435\u043D\u0438\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775406
    m_Localized: "\u041B\u044E\u0434\u0438 \u0440\u0435\u0434\u043A\u043E \u0434\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0445\u0440\u0430\u043C \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435
      \u043A\u0440\u0443\u0442\u043E\u0439 \u0433\u043E\u0440\u044B - \u043D\u0435
      \u0431\u044B\u043B\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435\u0439
      \u0438\u0434\u0435\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775407
    m_Localized: "\u0420\u0430\u0437 \u0443\u0436 \u043C\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C,
      \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u0440\u0438\u0437\u043E\u0432\u0451\u043C
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430 \u043A \u043E\u0442\u0432\u0435\u0442\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775408
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u0444\u0438\u0433\u0443\u0440\u0430 \u0440\u0435\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775409
    m_Localized: "\u041D\u043E \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435? "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775410
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C,
      \u043C\u044B \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0441\u0442\u0430\u0442\u0443\u0438 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430
      \u0441 \u043A\u0443\u0432\u0430\u043B\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775411
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u043E\u0435 \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C,
      \u0442\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430 \u0441
      \u043D\u0430\u043C\u0438 \u041C\u0430\u0441\u0442\u0435\u0440, \u043D\u0438\u043A\u0430\u043A\u0430\u044F
      \u0442\u0435\u043C\u043D\u043E\u0442\u0430 \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775412
    m_Localized: "\u0422\u0430\u043A \u0432\u044B \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0438
      \u0438\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u044B
      \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775413
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435\u2026 \u043D\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775414
    m_Localized: "\u041A\u0430\u043A \u0431\u044B \u0442\u043E \u043D\u0438 \u0431\u044B\u043B\u043E,
      \u0441 \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043C \u041F\u0440\u043E\u043C\u0435\u0442\u0435\u044F
      \u043C\u044B \u0441\u043C\u043E\u0436\u0435\u043C \u043F\u043E\u043C\u043E\u0447\u044C
      \u044D\u0442\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443 \u0432\u043D\u043E\u0432\u044C
      \u0441\u0438\u044F\u0442\u044C. \u0417\u0430 \u0434\u0435\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775415
    m_Localized: "\u0414\u043B\u044F \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435\u0435, \u0447\u0435\u043C \u0433\u043E\u0440\u0441\u0442\u044C
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0438 \u043F\u0430\u0440\u0430 \u043B\u0435\u043F\u0451\u0448\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775416
    m_Localized: "\u0412\u0435\u0442\u043A\u0438 \u043C\u0438\u0440\u0442\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0440\u044F\u0434\u0438\u0442\u044C
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u0438 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775417
    m_Localized: "\u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043D\u044B\u0439
      \u0441\u043E\u043A \u0441 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0434\u043B\u044F \u0440\u0435\u043B\u0430\u043A\u0441\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775418
    m_Localized: "\u0424\u0440\u0443\u043A\u0442\u044B \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0438 \u043A\u0430\u043A
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0430\u043D\u0442\u0438\u043E\u043A\u0441\u0438\u0434\u0430\u043D\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775419
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u0434\u0438\u043A\u043E\u0432\u0438\u043D\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 \u0442\u044B \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0448\u044C,
      \u043E\u0440\u0430\u043A\u0443\u043B? "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775420
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435 \u0438\u043C\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775421
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0432\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u0438\u043B\u0438\u043B \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438.
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u043D\u0435
      \u0432 \u0432\u043E\u0441\u0442\u043E\u0440\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775422
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E! \u0421\u0435\u0439\u0447\u0430\u0441
      \u043F\u043B\u044E\u043D\u0435\u043C, \u0434\u0443\u043D\u0435\u043C - \u0438
      \u043D\u0430\u0434\u0451\u0436\u043D\u043E \u0441\u043C\u0430\u0436\u0435\u043C
      \u043C\u0430\u0441\u043B\u043E\u043C. \u0411\u0443\u0434\u0435\u0442 \u043A\u0430\u043A
      \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775423
    m_Localized: "\u041E, \u041B\u0443\u0447\u0435\u0437\u0430\u0440\u043D\u044B\u0439,
      \u0431\u043E\u0433 \u0441\u0432\u0435\u0442\u0430 \u0438 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432,
      \u043F\u0440\u0438\u043C\u0438 \u043D\u0430\u0448\u0438 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0435
      \u0434\u0430\u0440\u044B \u0438 \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0438\u0441\u044C
      \u043D\u0430 \u0437\u043E\u0432 \u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u0441\u043B\u0443\u0433\u0438! "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775424
    m_Localized: "\u0412\u044B \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043F\u0440\u0438\u0451\u043C\u043D\u0443\u044E \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u043D\u0430 \u043B\u0438\u043D\u0438\u0438, \u0441 \u0432\u0430\u043C\u0438
      \u0441\u0432\u044F\u0436\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u0439
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440. \u041F\u043E\u043C\u043D\u0438\u0442\u0435:
      \u0432\u0430\u0448 \u0437\u0432\u043E\u043D\u043E\u043A \u0432\u0430\u0436\u0435\u043D
      \u0434\u043B\u044F \u043D\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775425
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0439
      \u043D\u0430 \u043C\u0435\u043B\u043E\u0434\u0438\u044E \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775426
    m_Localized: "\u0422\u0430\u043A \u044D\u0442\u043E \u0442\u044B \u0442\u043E\u0442
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439, \u043A\u0442\u043E \u0441\u043C\u0435\u043B
      \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u043C\u043E\u044E \u043C\u0443\u0437\u044B\u043A\u0443
      \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E\u0439?!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775427
    m_Localized: "\u041E, \u041A\u0430\u043B\u043B\u0438\u043E\u043F\u0430, \u0441\u043C\u0438\u043B\u0443\u0439\u0441\u044F!
      \u0422\u0432\u043E\u044F \u043C\u0443\u0437\u044B\u043A\u0430\u2026 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0442\u0430\u043A, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u043D\u0430
      \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043C\u0435\u043D\u044F
      \u043F\u043E\u0432\u0441\u044E\u0434\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775428
    m_Localized: "\u042D\u0442\u043E \u043D\u0435 \u043C\u0443\u0437\u044B\u043A\u0430
      \u0442\u0435\u0431\u044F \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u0443\u0435\u0442,
      \u0430 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775429
    m_Localized: "\u0412\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435?
      \u0411\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430
      \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775430
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435? \u041E,
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439, \u044D\u0442\u043E \u044F
      \u0435\u0449\u0451 \u043D\u0430 \u043B\u0438\u0440\u0443 \u043D\u0435 \u0441\u044B\u0433\u0440\u0430\u043B\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775431
    m_Localized: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C,
      \u0447\u0442\u043E \u044F \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044E
      \u0432\u0430\u0441 \u043E\u0442 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u0430\u0440\u043D\u044B\u0445
      \u0441\u043B\u043E\u0432, \u043D\u043E \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F \u043A \u0434\u0435\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775432
    m_Localized: "\u0422\u043E\u0447\u043D\u043E, \u044F \u0432\u0435\u0434\u044C
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435. \u041A\u0445\u043C. \u042F
      \u2014 \u041A\u0430\u043B\u043B\u0438\u043E\u043F\u0430, \u043C\u0443\u0437\u0430
      \u044D\u043F\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u043E\u044D\u0437\u0438\u0438
      \u0438 \u043F\u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443
      \u0434\u0435\u0436\u0443\u0440\u043D\u0430\u044F \u043F\u0440\u0438\u0451\u043C\u043D\u043E\u0439
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430. \u0427\u0435\u043C \u044F
      \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775433
    m_Localized: "\u0421\u043A\u0430\u0436\u0438, \u043A\u0443\u0434\u0430 \u0438\u0441\u0447\u0435\u0437
      \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775434
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u0447\u0438\u0442\u0430\u044E\u2026
      \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u0438\u0437\u0432\u0435\u0449\u0430\u0435\u043C
      \u0432\u0430\u0441, \u0413\u0440\u0435\u0446\u0438\u044F \u0431\u044B\u043B\u0430
      \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u043E\u0442 \u0443\u0441\u043B\u0443\u0433\u0438
      \"\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442\"
      \u043F\u043E \u043F\u0440\u0438\u0447\u0438\u043D\u0435 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438
      \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0439 \u043D\u0430 \u0440\u0430\u0441\u0447\u0451\u0442\u043D\u043E\u043C
      \u0441\u0447\u0451\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775435
    m_Localized: "\u041D\u043E \u043C\u044B \u0432\u0435\u0434\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u043F\u0440\u0435\u043F\u043E\u0434\u043D\u0435\u0441\u043B\u0438
      \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0434\u0430\u0440\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775436
    m_Localized: "\u0412 \u0442\u043E\u043C-\u0442\u043E \u0438 \u0434\u0435\u043B\u043E,
      \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u0432\u0435\u0447\u043D\u0430\u044F
      \u043D\u043E\u0447\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775437
    m_Localized: "\u041F\u043E\u043B\u043B\u0443\u043A\u0441! \u0424\u0430\u043A\u0435\u043B\u044B
      \u0433\u0430\u0441\u043D\u0443\u0442! \u0427\u0442\u043E \u044D\u0442\u043E
      \u0437\u043D\u0430\u0447\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775438
    m_Localized: "\u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E
      \u0443 \u043D\u0430\u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775439
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u043F\u043E\u0433\u0430\u0441.
      \u041F\u0440\u043E\u0441\u0442\u0438, \u041F\u043E\u043B\u043B\u0443\u043A\u0441,
      \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775440
    m_Localized: "\u041D\u043E \u043C\u044B \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E
      \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C! \u0414\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431 \u0432\u0441\u0451
      \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775441
    m_Localized: "\u0423\u0432\u044B, \u0432 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u043E\u043C
      \u0445\u0440\u0430\u043C\u0435 \u0431\u0435\u0437 \u0436\u0440\u0435\u0446\u043E\u0432
      \u044F \u0431\u0435\u0441\u0441\u0438\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775442
    m_Localized: "\u041C\u043E\u0439 \u0444\u0430\u043A\u0435\u043B \u0435\u0449\u0451
      \u0433\u043E\u0440\u0438\u0442! \u042F \u0440\u0430\u0437\u044B\u0449\u0443
      \u0436\u0440\u0435\u0446\u043E\u0432! \u041C\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C
      \u0445\u0440\u0430\u043C \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0441\u043D\u043E\u0432\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775443
    m_Localized: "\u0417\u0435\u0444\u0438\u0440! \u0417\u0435\u0444\u0438\u0440!
      \u0413\u0434\u0435 \u0442\u044B, \u043D\u0435\u0433\u043E\u0434\u043D\u0438\u043A?
      \u0417\u0435\u0444\u0438\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775444
    m_Localized: "\u0414\u043E\u0441\u0442\u043E\u043F\u043E\u0447\u0442\u0438\u043C\u044B\u0439
      \u0436\u0440\u0435\u0446, \u0437\u0430\u0447\u0435\u043C \u0442\u044B \u043A\u0440\u0438\u0447\u0438\u0448\u044C
      \u043D\u0430 \u0442\u0435\u043C\u043D\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775445
    m_Localized: "\u041C\u043E\u044F \u0441\u043E\u0431\u0430\u043A\u0430! \u0415\u0433\u043E
      \u0437\u043E\u0432\u0443\u0442 \u0417\u0435\u0444\u0438\u0440, \u0438 \u043E\u043D
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F! \u042F \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u043F\u043E\u0439\u0434\u0443 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775446
    m_Localized: "\u042F \u043F\u0440\u0438\u0432\u0435\u0434\u0443 \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775447
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0443\u0447\u0442\u0438:
      \u0442\u0430\u043C \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u043B\u043E\u043C\u0430\u043D
      \u043C\u043E\u0441\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775448
    m_Localized: "\u0414\u0430 \u043A\u0442\u043E \u0436 \u0432\u0441\u0451 \u043B\u043E\u043C\u0430\u0435\u0442
      \u044D\u0442\u0438 \u043C\u043E\u0441\u0442\u044B! \u0418 \u043A\u0430\u043A
      \u043D\u0430\u0437\u043B\u043E, \u0443 \u043D\u0430\u0441 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775449
    m_Localized: "\u041E\u0445\u043E\u0445, \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0431\u043E\u0433\u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u044F\u0442 \u043C\u043E\u044E
      \u0436\u0435\u0440\u0442\u0432\u0443. \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0441\u0430\u0440\u0430\u0439, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u043C\u043E\u0441\u0442. \u041D\u0430 \u0447\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0440\u0430\u0434\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F \u0413\u0440\u0435\u0446\u0438\u0438... "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775450
    m_Localized: "\u0410\u043F\u043E\u043B\u043B\u043E\u043D \u043C\u0438\u043B\u043E\u0441\u0442\u0438\u0432\u044B\u0439,
      \u044F \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0435\u043B.
      \u0423\u0436 \u0438 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E \u0432\u043A\u0443\u0441
      \u0435\u0434\u044B. \u041A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0442\u0430\u043A\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775451
    m_Localized: "\u041A\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u0442\u044B
      \u0433\u043E\u043B\u043E\u0434\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775452
    m_Localized: "\u0418\u043C\u0435\u0435\u0442 \u043B\u0438 \u0432\u0440\u0435\u043C\u044F
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435? \u0422\u0440\u0438 \u0447\u0430\u0441\u0430,
      \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775453
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0410\u043F\u043E\u043B\u043B\u043E\u043D
      \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u044B\u0439,
      \u043A\u0430\u043A \u0435\u0433\u043E \u0436\u0440\u0435\u0446\u044B. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775454
    m_Localized: "\u0411\u043E\u0433\u0438, \u043A\u0430\u043A \u0436\u0435 \u0432\u043A\u0443\u0441\u043D\u043E!
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435! \u0414\u0430\u0432\u0430\u0439
      \u043E\u0441\u0432\u0435\u0442\u0438\u043C \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775455
    m_Localized: "\u042F \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0442\u0440\u043E\u0441\u0442\u044C!
      \u0411\u0435\u0437 \u043D\u0435\u0451 \u043C\u043E\u0438 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043A\u043E\u043B\u0435\u043D\u0438 \u043D\u0438 \u0437\u0430 \u0447\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0442 \u0434\u043E\u0439\u0442\u0438
      \u0434\u043E \u0445\u0440\u0430\u043C\u0430! "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775456
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0431\u044B \u043D\u0435
      \u0432\u0437\u044F\u0442\u044C \u043A\u0430\u043A\u0443\u044E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u0430\u043B\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775457
    m_Localized: "\u0420\u0430\u0437\u0432\u0435 \u0447\u0442\u043E\u0431\u044B \u043E\u0433\u0440\u0435\u0442\u044C
      \u0442\u0435\u0431\u044F \u043F\u043E \u0441\u043F\u0438\u043D\u0435! \u042F
      \u0436\u0440\u0435\u0446, \u0430 \u043D\u0435 \u043F\u0430\u0441\u0442\u0443\u0445,
      \u043C\u043D\u0435 \u043F\u043E \u0441\u0442\u0430\u0442\u0443\u0441\u0443
      \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u043F\u0430\u043B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775458
    m_Localized: "\u0422\u044B \u043D\u0430\u0448\u0451\u043B \u0435\u0451! \u0414\u0430
      \u043F\u0440\u0435\u0431\u0443\u0434\u0435\u0442 \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430! \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0434\u0438 \u043C\u0435\u043D\u044F \u043A \u0445\u0440\u0430\u043C\u0443,
      \u0434\u0430 \u043F\u043E\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435!
      \u041F\u043E\u043C\u043D\u0438 \u043F\u0440\u043E \u043C\u043E\u0438 \u043A\u043E\u043B\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775459
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E
      \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C, \u0437\u0430 \u0447\u0442\u043E
      \u0443 \u043D\u0430\u0441 \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775460
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0442\u044B \u0437\u0432\u0430\u043B
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u0441\u043D\u043E\u0441\u043D\u043E\u0433\u043E
      \u043F\u0441\u0430? \u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438,
      \u044F \u0447\u0430\u0441\u0442\u0435\u043D\u044C\u043A\u043E \u0432\u044B\u043C\u0430\u043D\u0438\u0432\u0430\u044E
      \u0435\u0433\u043E \u0438\u0437 \u043F\u043E\u0434\u0432\u0430\u043B\u043E\u0432
      \u0445\u0440\u0430\u043C\u0430. \u041D\u0435\u0433\u043E\u0434\u043D\u0438\u043A
      \u043B\u044E\u0431\u0438\u0442 \u0433\u043E\u043D\u044F\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043C\u044B\u0448\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775461
    m_Localized: "\u0422\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0417\u0435\u0444\u0438\u0440. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0443 \u0442\u0435\u0431\u044F
      \u0442\u0430\u043A\u043E\u0439 \u0436\u0435, \u043A\u0430\u043A \u0438\u043C\u044F. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775462
    m_Localized: "\u0417\u0435\u0444\u0438\u0440! \u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F!
      \u0410 \u043A\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A?
      \u0410 \u043A\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u043A\u043E\u0441\u0442\u043E\u0447\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775463
    m_Localized: "\u041A\u0445\u043C-\u043A\u0445\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775464
    m_Localized: "\u0410\u0445, \u0434\u0430.. \u041D\u0438 \u043C\u0438\u043D\u0443\u0442\u044B
      \u043F\u043E\u043A\u043E\u044F \u0441\u0442\u0430\u0440\u0438\u043A\u0443!
      \u0412\u043E\u0442, \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0448
      \u043F\u0443\u0442\u044C \u043E\u0437\u0430\u0440\u044F\u0435\u0442 \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775465
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u043D\u0430\u0441
      \u0441\u043E\u0431\u0440\u0430\u043B? \u041D\u0430\u0448 \u0445\u0440\u0430\u043C
      \u0432 \u0440\u0443\u0438\u043D\u0430\u0445! \u0422\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u044B\u043B\u0438! \u042D\u0442\u043E \u0443\u0436\u0430\u0441, \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775466
    m_Localized: "\u041C\u044B \u0432\u0441\u0451 \u043F\u043E\u0447\u0438\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775467
    m_Localized: "\u041F\u043B\u044E\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775468
    m_Localized: "\u0414\u0443\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775469
    m_Localized: "\u0418 \u043F\u043E\u0434\u043C\u0435\u0442\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775470
    m_Localized: "\u0412\u0441\u0451 \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E,
      \u0431\u043E\u0433\u0438 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043D\u0430\u0441. \u0417\u0430 \u0434\u0435\u0440\u0437\u043E\u0441\u0442\u044C
      \u0438 \u043D\u0435\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C!
      \u041D\u0430\u043C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043C\u0438\u0440\u0451\u043D\u043D\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C
      \u0438\u0445 \u043A\u0430\u0440\u0443. \u0418 \u043D\u0435\u0442 \u043D\u0430\u043C
      \u043D\u0438 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F, \u043D\u0438
      \u043D\u0430\u0434\u0435\u0436\u0434\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775471
    m_Localized: "\u041A\u043E\u043B\u043E\u043D\u043D\u044B \u043F\u043E\u043A\u0440\u0430\u0441\u0438\u043C.
      \u0412 \u043A\u0440\u0430\u0441\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775472
    m_Localized: "\u0421 \u043F\u043E\u0437\u043E\u043B\u043E\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775473
    m_Localized: "\u041F\u043E \u0440\u0443\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775474
    m_Localized: "\u0422\u043E\u0433\u0434\u0430, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043D\u0430\u0434\u0435\u0436\u0434\u0430 \u0435\u0449\u0451 \u0435\u0441\u0442\u044C.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443,
      \u0434\u0435\u0442\u0438 \u043C\u043E\u0438! \u041D\u0430\u043C \u043E\u0447\u0435\u043D\u044C
      \u043C\u043D\u043E\u0433\u043E\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775475
    m_Localized: "\u041C\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438
      \u0441\u043F\u0438\u0441\u043E\u043A \u0440\u0430\u0431\u043E\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0434\u043B\u044F
      \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775476
    m_Localized: "\u0417\u0430\u043B \u0434\u043B\u044F \u043F\u0438\u0440\u0448\u0435\u0441\u0442\u0432,
      \u043F\u043E\u0437\u043E\u043B\u043E\u0447\u0435\u043D\u043D\u044B\u0435 \u0436\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0435
      \u043F\u043E\u043A\u043E\u0438, \u0431\u0430\u0441\u0441\u0435\u0439\u043D?
      \u041D\u043E \u0447\u0442\u043E \u0438\u0437 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u043E\u043C\u043E\u0447\u044C \u0432
      \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u043A \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775477
    m_Localized: "\u0422\u044B \u043D\u0435\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u0438\u0442\u0430\u0435\u0448\u044C, \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440,
      \u0442\u0430\u043C \u0435\u0449\u0451 \u043D\u043E\u0432\u044B\u0439 \u0430\u043B\u0442\u0430\u0440\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775478
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043C\u044B \u043D\u0430\u0447\u043D\u0451\u043C
      \u0441 \u043A\u043E\u043D\u0446\u0430 \u0441\u043F\u0438\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775479
    m_Localized: "\u0418..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775480
    m_Localized: "\u0418 \u044D\u0442\u043E \u043D\u0435 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435
      \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u0433\u0440\u0435\u0431\u0430!
      \u0423\u0447\u0435\u043D\u0438\u043A\u0438! \u0413\u043E\u0442\u043E\u0432\u044C\u0442\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u043D\u0430\u043C
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775481
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u044B \u0432\u043E\u0437\u044C\u043C\u0451\u043C
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u0438, \u0442\u043E \u0443 \u043D\u0430\u0441
      \u0432\u044B\u0439\u0434\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F
      \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043A\u0440\u0430\u0441\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775482
    m_Localized: "\u041D\u0443, \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u0438
      \u0443 \u043D\u0430\u0441 \u0432 \u0438\u0437\u0431\u044B\u0442\u043A\u0435.
      \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775483
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043F\u0440\u0435\u0432\u0437\u043E\u0448\u0451\u043B
      \u0441\u0430\u043C \u0441\u0435\u0431\u044F! \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0435\u0440\u044B\u0439 \u0446\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775484
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775485
    m_Localized: "\u0414\u0430? \u0410 \u044F \u0435\u0449\u0451 \u043F\u043E\u0434\u0443\u043C\u0430\u043B,
      \u0437\u0430\u0447\u0435\u043C \u043C\u044B \u043A\u0440\u0430\u0441\u0438\u043C
      \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0435 \u043A\u043E\u043B\u043E\u043D\u043D\u044B
      \u0432 \u0446\u0432\u0435\u0442 \u043C\u0440\u0430\u043C\u043E\u0440\u0430.
      \u041E\u0445 \u0443\u0436 \u044D\u0442\u043E\u0442 \u0434\u0430\u043B\u044C\u0442\u043E\u043D\u0438\u0437\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775486
    m_Localized: "\u041E\u0440\u0430\u043A\u0443\u043B! \u041D\u0430 \u043D\u0430\u0448\u0435\u0433\u043E
      \u043F\u043E\u0445\u043E\u0436 \u043A\u0430\u043A \u0434\u0432\u0435 \u043A\u0430\u043F\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775487
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u044F \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u044F\u043B\u0441\u044F
      \u041C\u0435\u0434\u0443\u0437\u043E\u0439 \u0413\u043E\u0440\u0433\u043E\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775488
    m_Localized: "\u042D\u0442\u043E \u0432\u043E\u0438\u043D? \u0423 \u043D\u0435\u0433\u043E
      \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C \u0410\u0440\u0435\u0441.
      \u042D\u0442\u043E... \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u043E\u0439
      \u0431\u043E\u0433. \u041E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E
      \u0434\u0440\u0443\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775489
    m_Localized: "\u041A\u0443\u0437\u043D\u0435\u0446! \u0413\u0435\u0444\u0435\u0441\u0442
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
      \u0416\u0430\u043B\u044C, \u0443 \u043D\u0430\u0441 \u0445\u0440\u0430\u043C
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775490
    m_Localized: "\u0410\u0442\u043B\u0435\u0442. \u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0438 \u043C\u0435\u043D\u044F \u0432\u0435\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0433\u0438\u043C\u043D\u0430\u0441\u0442\u0438\u043A\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u044F \u043F\u043E\u0434\u0432\u0435\u0440\u043D\u0443\u043B \u043A\u043E\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775491
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C! \u0421\u043A\u0430\u0436\u0438,
      \u0441\u043B\u0443\u0436\u0438\u0442\u0435\u043B\u044C \u0410\u0441\u043A\u043B\u0435\u043F\u0438\u044F
      \u0438 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430, \u043A\u0430\u043A
      \u043C\u043D\u0435 \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C \u0441\u0432\u043E\u0439
      \u0440\u0430\u0434\u0438\u043A\u0443\u043B\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775492
    m_Localized: "\u041E\u043D \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775493
    m_Localized: "\u042F \u0437\u043D\u0430\u044E, \u043D\u043E \u043D\u0430\u0434\u0435\u0436\u0434\u0430
      \u0443\u043C\u0438\u0440\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775494
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u043F\u043E\u044D\u0442\u0430\u043C
      \u043B\u0438\u0440\u0430? \u041E\u043D\u0438 \u0436\u0435 \u043D\u0435 \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775495
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0430\u0443\u043D\u0434\u0442\u0440\u0435\u043A
      \u0432\u0441\u0451 \u0434\u0435\u043B\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0435.
      \u0414\u0430\u0436\u0435 \u043F\u043B\u043E\u0445\u0438\u0435 \u0441\u0442\u0438\u0445\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775496
    m_Localized: "\u0422\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438,
      \u0443 \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0432 \u0440\u0443\u043A\u0430\u0445 \u043A\u0438\u0444\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775497
    m_Localized: "\u0427\u0442\u043E \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775498
    m_Localized: "\u0420\u0430\u0437\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u044C
      \u043B\u0438\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775499
    m_Localized: "\u0411\u0443\u0434\u0435\u043C \u043D\u0430\u0434\u0435\u044F\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0410\u043F\u043E\u043B\u043B\u043E\u043D \u0442\u043E\u0436\u0435
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A \u043E\u043D\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039678775500
    m_Localized: "\u0418\u0442\u0430\u043A, \u0443 \u043D\u0430\u0441 \u043F\u044F\u0442\u044C
      \u0441\u0442\u0430\u0442\u0443\u0439. \u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u043C \u0432\u0441\u0451
      \u0436\u0435 \u0441\u0442\u043E\u0438\u043B\u043E \u043F\u0440\u0438\u0434\u0435\u043B\u0430\u0442\u044C
      \u0444\u0430\u043A\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969600
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0433\u043B\u044F\u043D\u044C,
      \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u043D\u0435 \u043A\u0440\u0430\u0441\u043E\u0442\u0430,
      \u0442\u043E \u044F \u0443\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E
      \u0447\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969601
    m_Localized: "\u041C\u044B \u0432\u0441\u0451 \u0441\u0434\u0435\u043B\u0430\u043B\u0438,
      \u0445\u0440\u0430\u043C \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u0440\u0430\u0448\u0435
      \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E. \u0416\u0440\u0435\u0446,
      \u0442\u044B \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969602
    m_Localized: "\u041D\u0435\u0442, \u0435\u0441\u043B\u0438 \u0431\u044B \u0441
      \u0442\u043E\u0431\u043E\u0439 \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0430\u0441.
      \u0423\u0437\u0440\u0438 \u0436\u0435! \u0422\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u043B\u0443\u0447\u0448\u0438\u0435 \u0436\u0440\u0435\u0446\u044B \u0413\u0440\u0435\u0446\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969603
    m_Localized: "\u041D\u043E... \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969604
    m_Localized: "\u0422\u0438\u0445\u043E, \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440!
      \u041C\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u043A \u0440\u0430\u0437
      \u043D\u0430 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043F\u0440\u0438\u0451\u043C\u043D\u043E\u0439...
      \u043E\u0445, \u0441\u0432\u044F\u0442\u0430\u044F \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u0430\u044F
      \u0432\u0435\u0442\u0432\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969605
    m_Localized: "\u0427\u0442\u043E? \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969606
    m_Localized: "\u041C\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u043C
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u043E\u043C.
      \u0411\u043E\u044E\u0441\u044C, \u043C\u044B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969607
    m_Localized: "\u041E \u0447\u0451\u043C \u0442\u044B? \u0427\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u043B\u0438\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969608
    m_Localized: "\u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E
      \u044F \u0440\u0435\u0448\u0438\u043B \u043F\u0440\u0438\u0439\u0442\u0438
      \u043B\u0438\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969609
    m_Localized: "\u041E\u0445, \u0441\u0432\u044F\u0442\u0430\u044F \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u0430\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969610
    m_Localized: "\u041E, \u041B\u0443\u0447\u0435\u0437\u0430\u0440\u043D\u044B\u0439,
      \u043C\u044B, \u0441\u043C\u0438\u0440\u0435\u043D\u043D\u044B\u0435 \u0442\u0432\u043E\u0438
      \u0441\u043B\u0443\u0433\u0438, \u043F\u043E\u043B\u044C\u0449\u0435\u043D\u044B
      \u0442\u0432\u043E\u0438\u043C \u0432\u043D\u0438\u043C\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969611
    m_Localized: "\u0423\u0439\u043C\u0438\u0441\u044C, \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439,
      \u044F \u043D\u0435 \u043A \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0448\u0451\u043B.
      \u0422\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969612
    m_Localized: "\u042F?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969613
    m_Localized: "\u0422\u044B! \u042F \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0442\u0432\u043E\u044E \u0441\u0443\u0435\u0442\u0443, \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439.
      \u041F\u043E \u043F\u0440\u0430\u0432\u0434\u0435, \u043C\u043D\u043E\u0433\u0438\u0435
      \u0432 \u043E\u0442\u0434\u0435\u043B\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438.
      \u0412\u0441\u0435 \u0433\u043E\u0440\u044F\u0447\u0438\u0435 \u043B\u0438\u043D\u0438\u0438
      \u043E\u0431\u043E\u0440\u0432\u0430\u043B, \u0413\u0435\u043B\u0438\u043E\u0441
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432\u043E\u0437\u043C\u0443\u0449\u0430\u043B\u0441\u044F.
      \u0412\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969614
    m_Localized: "\u042F \u0441\u043A\u043E\u0440\u0435\u0435 \u043F\u043E\u043B\u044C\u0449\u0435\u043D,
      \u0447\u0435\u043C \u043D\u0430\u043F\u0443\u0433\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969615
    m_Localized: "\u042D\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u0432\u0430\u043B\u0430!
      \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432\u043E\u0442
      \u044D\u0442\u043E, \u043C\u043E\u0439 \u0442\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0439
      \u0445\u0440\u0430\u043C - \u0432\u043E\u0442 \u0447\u0442\u043E \u043D\u0435
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0442! \u0412\u044B
      \u0432\u043E\u043E\u0431\u0449\u0435 \u043F\u043E\u043C\u043D\u0438\u0442\u0435,
      \u043A\u0442\u043E \u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969616
    m_Localized: "\u0410\u043F\u043E\u043B\u043B\u043E\u043D, \u0441\u044B\u043D
      \u0417\u0435\u0432\u0441\u0430! \u042F, \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0447\u0438\u043C,
      \u043D\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u043B\u0438\u0446\u043E
      \u043D\u0430 \u041E\u043B\u0438\u043C\u043F\u0435. \u0423 \u043C\u0435\u043D\u044F
      \u043E\u0447\u0435\u043D\u044C \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C.
      \u0425\u043E\u0442\u044C \u044F \u0438 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E,
      \u043A\u0430\u043A \u043E\u043D\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969617
    m_Localized: "\u041C\u044B \u043F\u043E\u043C\u043D\u0438\u043C... \u044D, \u0412\u0430\u0448\u0435
      \u0421\u0438\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969618
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0447\u0435\u043C\u0443
      \u0443 \u043C\u0435\u043D\u044F \u0442\u0430\u043A\u0430\u044F \u0443\u0436\u0430\u0441\u043D\u0430\u044F
      \u0441\u0442\u0430\u0442\u0443\u044F?! \u0413\u0434\u0435 \u0445\u043E\u0442\u044C
      \u043A\u0430\u043F\u043B\u044F \u0448\u0438\u043A\u0430? \u041D\u0438 \u043C\u043E\u0435\u0439
      \u043A\u0440\u0430\u0441\u043E\u0442\u044B, \u043D\u0438 \u043A\u0440\u0443\u0442\u043E\u0441\u0442\u0438!
      \u041F\u043E\u0437\u043E\u0440\u0438\u0449\u0435! \u041D\u0430\u0434\u043E
      \u0431\u044B\u043B\u043E \u0432\u0430\u043C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0432\u0435\u0442 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969619
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0438 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u0432\u0430\u0441
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B. \u0410 \u044F, \u043C\u0435\u0436\u0434\u0443
      \u043F\u0440\u043E\u0447\u0438\u043C, \u043E\u0447\u0435\u043D\u044C \u0437\u0430\u043D\u044F\u0442\u043E\u0439.
      \u0427\u0430\u043E, \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969620
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u0439, \u043E, \u043C\u043E\u0433\u0443\u0447\u0438\u0439
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D, \u0441\u043C\u0438\u043B\u0443\u0439\u0441\u044F!
      \u0415\u0441\u043B\u0438 \u0432\u0441\u0451 \u0434\u0435\u043B\u043E \u0432
      \u0441\u0442\u0430\u0442\u0443\u0435, \u0442\u043E \u043C\u044B \u044D\u0442\u043E
      \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969621
    m_Localized: "\u0414\u0430 \u043D\u0443? \u041A\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969622
    m_Localized: "\u041A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043C\u043E\u0438
      \u0443\u0447\u0435\u043D\u0438\u043A\u0438: \u043F\u043B\u044E\u043D\u0435\u043C,
      \u0434\u0443\u043D\u0435\u043C - \u0438 \u0441\u0434\u0435\u043B\u0430\u0435\u043C
      \u043D\u043E\u0432\u0443\u044E. \u041A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u0430
      \u0442\u0432\u043E\u0435\u0433\u043E \u0441\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0432\u0437\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969623
    m_Localized: "\u041D\u0443 \u0432\u043E\u0442 \u043A\u043E\u0433\u0434\u0430
      \u0441\u0434\u0435\u043B\u0430\u0435\u0448\u044C, \u0442\u043E\u0433\u0434\u0430
      \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C. \u0410 \u043F\u043E\u043A\u0430
      - \u043D\u0430 \u0441\u0432\u044F\u0437\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969624
    m_Localized: "\u0422\u044B \u0441\u0434\u0435\u0440\u0436\u0430\u043B \u0441\u043B\u043E\u0432\u043E,
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439. \u0422\u0435\u043F\u0435\u0440\u044C
      \u044F \u0432\u044B\u0433\u043B\u044F\u0436\u0443 \u043A\u0440\u0443\u0442\u043E!
      \u0414\u0430\u0436\u0435 \u044D\u0442\u0438 \u043B\u0435\u043D\u0442\u044F\u0438-\u0436\u0440\u0435\u0446\u044B
      \u0437\u0430 \u0434\u0435\u043B\u043E \u0432\u0437\u044F\u043B\u0438\u0441\u044C.
      \u042F \u0434\u043E\u0432\u043E\u043B\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969625
    m_Localized: "\u0421\u043C\u0435\u0435\u043C \u043B\u0438 \u043C\u044B \u043D\u0430\u0434\u0435\u044F\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u043D\u0430\u043C \u0432\u0435\u0440\u043D\u0443\u0442
      \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969626
    m_Localized: "\u0422\u0430\u043A \u0438 \u0431\u044B\u0442\u044C! \u0412\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0434\u0430\u0442\u044C \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u0435
      \u043E \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438
      \u0443\u0441\u043B\u0443\u0433\u0438, \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C
      \u043A\u043E\u043F\u0438\u0438 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0432 \u043E\u0442\u0434\u0435\u043B... "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969627
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C \u0442\u0435\u0431\u044F,
      \u043B\u0443\u0447\u0435\u0437\u0430\u0440\u043D\u044B\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969628
    m_Localized: "\u0414\u0430, \u0434\u0430, \u043A\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0448\u044C.
      \u0412 \u043E\u0431\u0449\u0435\u043C, \u043F\u043E\u043C\u043D\u0438\u0442\u0435
      \u043C\u043E\u044E \u0434\u043E\u0431\u0440\u043E\u0442\u0443! \u041F\u043E\u0431\u043E\u043B\u044C\u0448\u0435
      \u0441\u0442\u0430\u0442\u0443\u0439, \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0439
      \u0438 \u043F\u0440\u043E\u0447\u0435\u0433\u043E! \u041C\u043D\u0435 \u043F\u043E\u0440\u0430,
      \u043D\u043E \u044F \u0437\u0430\u043F\u043E\u043C\u043D\u044E \u0442\u0435\u0431\u044F,
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439. \u0415\u0441\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041D\u0443 \u0432\u0441\u0451,
      \u0447\u0430\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969629
    m_Localized: "\u0427\u0442\u043E \u043E\u043D \u0438\u043C\u0435\u043B \u0432
      \u0432\u0438\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969630
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435 \u0438\u043C\u0435\u044E.
      \u041D\u043E \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969631
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969632
    m_Localized: "\u041C\u044B \u0441\u043C\u043E\u0436\u0435\u043C \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0434\u0435\u0440\u0435\u0432\u043E \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969633
    m_Localized: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E! \u041E\u0431\u043E\u0436\u0430\u044E
      \u0437\u0430\u043F\u0430\u0445 \u0441\u0432\u0435\u0436\u0435\u0439 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B
      \u043F\u043E \u0443\u0442\u0440\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969634
    m_Localized: "\u041F\u0440\u043E\u043C\u0435\u0442\u0435\u0435\u0432\u0430 \u0431\u043E\u0440\u043E\u0434\u0430,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043D\u0430 \u043C\u043E\u0451\u043C
      \u043F\u0443\u0442\u0438 \u0432\u0435\u0447\u043D\u043E \u0440\u0443\u0448\u0430\u0442\u0441\u044F
      \u043C\u043E\u0441\u0442\u044B \u0438 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B?
      \u042F \u0443\u0436\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0447\u044C\u044F-\u0442\u043E \u0437\u043B\u0430\u044F
      \u0432\u043E\u043B\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969635
    m_Localized: "\u0412\u0441\u0451 \u0433\u043E\u0442\u043E\u0432\u043E! \u041A\u043B\u044F\u043D\u0443\u0441\u044C
      \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C, \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442
      \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0442\u0440\u0438\u0443\u043C\u0444! "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969636
    m_Localized: "\u0418\u043B\u0438 \u0444\u0435\u0435\u0440\u0438\u0447\u043D\u044B\u0439
      \u043F\u0440\u043E\u0432\u0430\u043B. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969637
    m_Localized: "\u041D\u0435 \u0431\u0443\u0434\u044C \u043F\u0435\u0441\u0441\u0438\u043C\u0438\u0441\u0442\u043E\u043C!
      \u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
      \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0443\u0442\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969638
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0432\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0437\u0432\u0443\u043A\u0430 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\u0430
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043D\u0435
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969639
    m_Localized: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \"\u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969640
    m_Localized: "\u0411\u0435\u0437 \u043F\u043E\u043D\u044F\u0442\u0438\u044F,
      \u043D\u043E \u043E\u043D \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0434\u0435\u0441\u044C
      \u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969641
    m_Localized: "...\u0434\u0430 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0441\u044F,
      \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0439! \u0412\u0438\u0434\u0435\u043B
      \u0431\u044B \u0442\u044B \u0441\u0432\u043E\u0451 \u043B\u0438\u0446\u043E,
      \u0442\u0430\u043A\u0430\u044F \u0443\u043C\u043E\u0440\u0430! \u042F \u0436\u0435
      \u0431\u043E\u0433, \u0437\u0430\u0431\u044B\u043B? \u041F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435
      \u0441\u0432\u043E\u0439 \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969642
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B \u0432 \u043F\u0435\u0449\u0435\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969643
    m_Localized: "\u042F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969644
    m_Localized: "\u0414\u0430\u0439 \u0443\u0433\u0430\u0434\u0430\u044E: \u0432\u0440\u044F\u0434
      \u043B\u0438 \u0442\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0432 \u043D\u0430\u0448\u0443 \u0447\u0435\u0441\u0442\u044C
      \u0443\u0447\u0440\u0435\u0436\u0434\u0430\u044E\u0442 \u043D\u043E\u0432\u044B\u0435
      \u0418\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969645
    m_Localized: "\u0418 \u0434\u0430\u0436\u0435 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043D\u0435 \u0443\u0447\u0440\u0435\u0436\u0434\u0430\u044E\u0442. \u0423
      \u043D\u0438\u0445 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969646
    m_Localized: "\u0427\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442 \"\u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\"? "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969647
    m_Localized: "\u041D\u0435 \u0441\u043A\u0430\u0437\u0430\u043D\u043E. \u0412
      \u0445\u0440\u0430\u043C\u0435 \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D\u0430
      \u043C\u043E\u043B\u0447\u0430\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043D\u0430\u0441 \u043F\u0440\u043E\u0441\u044F\u0442 \u043F\u0440\u0438\u0431\u044B\u0442\u044C
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u043E\u0440\u0435\u0435. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969648
    m_Localized: "\u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B?
      \u042D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0436\u0440\u0435\u0446\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969649
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u044B
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0434\u043D\u0435\u0432\u043D\u043E\u0439
      \u0441\u0432\u0435\u0442. \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0436\u0440\u0435\u0446\u044B \u043C\u043E\u043B\u0447\u0430\u0442. \u0418
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
      \u043B\u044E\u0434\u044F\u043C - \u0445\u043E\u0440\u043E\u0448\u043E. \u0422\u0435\u043C
      \u0431\u043E\u043B\u0435\u0435, \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0431\u0435\u0434\u0430
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u0432\u0441\u0435\u0439 \u0413\u0440\u0435\u0446\u0438\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969650
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u043C \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0441\u043F\u0435\u0448\u0438\u0442\u044C! \u041D\u043E \u0432\u0441\u0451
      \u0436\u0435: \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B \u0432 \u043F\u0435\u0449\u0435\u0440\u0435? "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969651
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439. \u041D\u043E \u0435\u0441\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439
      - \u043D\u0430\u043F\u0440\u044F\u043C\u0438\u043A \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u0443. "
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969652
    m_Localized: "\u0410 \u043E\u043D \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?
      \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969653
    m_Localized: "\u0415\u0441\u0442\u044C \u043B\u0438\u0448\u044C \u043E\u0434\u0438\u043D
      \u0441\u043F\u043E\u0441\u043E\u0431 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969654
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0433\u043E\u0440\u043E\u0434! \u0421\u043A\u043E\u0440\u0435\u0435,
      \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D \u043D\u0435 \u043B\u044E\u0431\u0438\u0442
      \u0436\u0434\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969655
    m_Localized: "\u0425\u0432\u0430\u043B\u0430 \u0431\u043E\u0433\u0430\u043C,
      \u043D\u0430\u0441 \u0436\u0434\u0451\u0442 \u043C\u043E\u0440\u0441\u043A\u0430\u044F
      \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C, \u0430 \u043D\u0435 \u0437\u0430\u0442\u0445\u043B\u043E\u0441\u0442\u044C
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969656
    m_Localized: "\u041D\u043E \u0447\u0442\u043E \u044D\u0442\u043E \u0437\u0430
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0437\u0430\u0440\u0435\u0432\u043E?
      \u041C\u0430\u044F\u043A? \u041F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D
      \u0433\u043E\u0440\u0438\u0442 \u0434\u043D\u0451\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969657
    m_Localized: "\u041A\u043B\u044F\u043D\u0443\u0441\u044C \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      \u041F\u0440\u043E\u043C\u0435\u0442\u0435\u044F! \u042D\u0442\u043E \u043D\u0435
      \u043C\u0430\u044F\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969658
    m_Localized: "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0436\u0434\u0451\u0442 \u043D\u0430\u0441 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969659
    m_Localized: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E, \u0447\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0430\u0448\u0438\u043C \u043F\u043E\u0442\u043E\u043C\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969660
    m_Localized: "\u041D\u0443 \u0438\u043B\u0438 \u0445\u043E\u0442\u044F \u0431\u044B
      \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F
      \u0434\u043B\u044F \u043F\u043E\u0441\u0438\u0434\u0435\u043B\u043E\u043A \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969661
    m_Localized: "\u041F\u043E\u043B\u043B\u0443\u043A\u0441, \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u043B\u0438 \u0442\u0435\u0431\u0435, \u0447\u0442\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u0430
      \u0437\u0434\u0435\u0441\u044C... \u043E\u043D\u0430 \u043A\u0430\u043A-\u0442\u043E
      \u0437\u043D\u0430\u043A\u043E\u043C\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969662
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0431\u0443\u0434\u0442\u043E
      \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442 \u043D\u0430\u0437\u0430\u0434
      \u0434\u043E\u0431\u0438\u043B\u0438\u0441\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0441\u0432\u0435\u0442\u0430 \u0432 \u0413\u0440\u0435\u0446\u0438\u044E,
      \u0447\u0442\u043E\u0431\u044B \u0441 \u043D\u043E\u0432\u044B\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438 \u0431\u0435\u0436\u0430\u0442\u044C \u0432\u043E
      \u0442\u044C\u043C\u0443 \u043F\u0435\u0449\u0435\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969663
    m_Localized: "\u041D\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u0440\u043E\u043B\u0438\u0442\u044C
      \u0441\u0432\u0435\u0442 \u043D\u0430 \u0442\u0430\u0439\u043D\u044B, \u0441\u043A\u0440\u044B\u0442\u044B\u0435
      \u043E\u0442 \u043D\u0430\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969664
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u041F\u043E\u043B\u043B\u0443\u043A\u0441,
      \u044D\u0442\u0438 \u0433\u0440\u0438\u0431\u044B \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F!
      \u041E\u043D\u0438 \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u043C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969665
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u0432\u043E\u0437\u044C\u043C\u0451\u043C
      \u0438\u0445 \u0441 \u0441\u043E\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969666
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0438 \u0440\u0430\u0441\u0442\u0443\u0442
      \u043F\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044E
      \u043A \u0432\u044B\u0445\u043E\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969667
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u043E\u0432\u044B\u0439 \u043F\u043B\u0430\u043D:
      \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u0433\u0440\u0438\u0431\u044B
      \u0438 \u0438\u0434\u0451\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969668
    m_Localized: "\u041D\u0443 \u0438 \u043D\u0443, \u043E\u043F\u044F\u0442\u044C
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u0441\u0442!
      \u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430
      \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u043C\u044B \u0432\u043C\u0435\u0441\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969669
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0442\u044B \u043F\u0440\u043E\u043A\u043B\u044F\u0442
      \u0431\u043E\u0433\u0430\u043C\u0438 \u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0435
      \u043C\u043E\u0441\u0442\u044B? \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E
      \u0442\u0432\u043E\u044F \u0441\u0443\u0434\u044C\u0431\u0430, \u0434\u0440\u0443\u0436\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969670
    m_Localized: "\u041E\u0447\u0435\u043D\u044C \u0441\u043C\u0435\u0448\u043D\u043E,
      \u0443\u0447\u0438\u0442\u0435\u043B\u044C. \u041D\u0430\u0434\u043E \u0431\u044B
      \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C \u043D\u0430\u0448\u0435 \u0441\u0447\u0430\u0441\u0442\u044C\u0435,
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0432 \u0435\u0433\u043E \u0437\u0430\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969671
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u043D\u0430\u0439\u0434\u0451\u043C
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C.
      \u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u0442\u0432\u043E\u0451
      \"\u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u0435\" \u0433\u043E\u0442\u043E\u0432\u043E
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043D\u0430\u0441 \u0431\u0435\u0437
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430
      \u0437\u0430 \u0441\u043E\u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969672
    m_Localized: "\u0410\u043A\u0446\u0438\u044F \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
      \xAB\u041E\u043B\u0438\u043C\u043F\xBB? \u0427\u0442\u043E \u044D\u0442\u043E
      \u0437\u0430 \u0434\u0438\u0432\u043E \u0442\u0430\u043A\u043E\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969673
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435.
      \u0423 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u0433\u0430\u0434\u0430\u0442\u0435\u043B\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969674
    m_Localized: "\u041D\u0443\u0442\u0440\u043E\u043C \u0441\u0432\u043E\u0438\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E: \u044D\u0442\u043E \u0437\u043D\u0430\u043A
      \u0431\u043E\u0436\u0438\u0439, \u0447\u0442\u043E \u043D\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969675
    m_Localized: "\u0412\u043E\u0442 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u043D\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0442\u0432\u043E\u0438
      \u043D\u0430\u0432\u044B\u043A\u0438 \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043D\u0438\u044F!
      \u0418 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435,
      \u0447\u0442\u043E \u043D\u0430\u043C \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043D\u0443\u0436\u043D\u043E \u0432\u043E\u0437\u0432\u0435\u0441\u0442\u0438
      \u0441\u0442\u0430\u0442\u0443\u044E \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969676
    m_Localized: "\u0412\u0441\u0451 \u0432 \u043D\u0430\u0448\u0438\u0445 \u0440\u0443\u043A\u0430\u0445.
      \u0418\u0441\u043F\u0440\u0430\u0432\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969677
    m_Localized: "\u0421\u0442\u0430\u0442\u0443\u044F \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
      \u0431\u044B \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0439 \u0438\u0437
      \u0432\u0441\u0435\u0445, \u0435\u0441\u043B\u0438 \u0431\u044B \u043D\u0430
      \u043D\u0435\u0451 \u043F\u0430\u0434\u0430\u043B \u0441\u0432\u0435\u0442,
      \u0430 \u043D\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969678
    m_Localized: "\u041E\u043D\u0430 \u0438 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0445\u043E\u0440\u043E\u0448\u0430 \u0442\u0430\u043A, \u0447\u0442\u043E
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0441\u043D\u043E\u0441\u0438\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969679
    m_Localized: "\u0415\u0449\u0451 \u0443\u0442\u0440\u043E\u043C \u0433\u043E\u043B\u043E\u0432\u0430
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043D\u0430
      \u0435\u0433\u043E \u043F\u043B\u0435\u0447\u0430\u0445. \u041F\u043E\u0447\u0435\u043C\u0443
      \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0432\u043E\u0438 \u0441\u043B\u043E\u0432\u0430
      \u0437\u0432\u0443\u0447\u0430\u0442 \u0442\u0430\u043A \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969680
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u0430
      \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0430 \u0432\u0441\u0435 \u043F\u043B\u0430\u043D\u044B,
      \u0438 \u043C\u044B \u0441\u043F\u0443\u0442\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430 \u0441 \u043A\u0443\u0432\u0430\u043B\u0434\u043E\u0439\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969681
    m_Localized: "\u2026\u0417\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043E \u0441\u0442\u0430\u0442\u0443\u0435,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u044B \u0434\u043E\u043B\u0436\u043D\u044B
      \u043F\u043E\u043C\u043E\u0447\u044C \u043B\u044E\u0434\u044F\u043C! \u042F
      \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0415\u043B\u0435\u043D\u0430 \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969682
    m_Localized: "\u0415\u043B\u0435\u043D\u0430! \u0422\u044B \u043C\u0435\u043D\u044F
      \u0441\u043B\u044B\u0448\u0438\u0448\u044C?!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969683
    m_Localized: "\u041F\u043E\u043B\u043B\u0443\u043A\u0441! \u042F \u0437\u0434\u0435\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969684
    m_Localized: "\u042D\u0442\u043E \u0435\u0451 \u0433\u043E\u043B\u043E\u0441!
      \u041E\u043D \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043E\u0442\u043A\u0443\u0434\u0430-\u0442\u043E
      \u0441 \u0441\u0435\u0432\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969685
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u043E\u043D\u0430
      \u0442\u043E\u0447\u043D\u043E \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969686
    m_Localized: "\u0411\u0435\u0433\u0438\u0442\u0435 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440,
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u0430\u043C \u0441\u0432\u0435\u0442\u043B\u0435\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969687
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u043B\u0438\u0448\u044C
      \u044F \u0432\u043B\u0430\u0434\u0435\u044E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969688
    m_Localized: "\u2026 \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0440\u0435\u0448\u0438\u043B
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043A \u0442\u0435\u0431\u0435,
      \u041E\u0440\u0430\u043A\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969689
    m_Localized: "\u041C\u0443\u0434\u0440\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
      \u0434\u0438\u0442\u044F, \u0432\u0435\u0434\u044C \u043D\u0438\u043A\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043D\u0435 \u0432\u043B\u0430\u0434\u0435\u0435\u0442
      \u0442\u0435\u043C\u0438 \u0436\u0435 \u043D\u0430\u0432\u044B\u043A\u0430\u043C\u0438
      \u043E\u0431\u0449\u0435\u043D\u0438\u044F, \u0447\u0442\u043E \u0438 \u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969690
    m_Localized: "\u041E\u0440\u0430\u043A\u0443\u043B! \u041D\u0443\u0436\u043D\u043E
      \u0441\u043A\u043E\u0440\u0435\u0435 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969691
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043C\u043E\u0439 \u043E\u0442\u0432\u0435\u0442
      \u0432\u0435\u0440\u0435\u043D \u0438 \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043C\u043E\u0447\u044C \u0432 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0443\u0442 \u0437\u0432\u043E\u043D\u0438\u0442\u044C
      \u0438\u0437 \u0434\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430
      \u0410\u0440\u0442\u0435\u043C\u0438\u0434\u044B, \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435
      \u043C\u043D\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0437\u0432\u0451\u0437\u0434 \u043D\u0430 \u043D\u0435\u0431\u0435 \u0437\u0430
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969692
    m_Localized: "\u0410 \u0435\u0449\u0451 \u0441\u0442\u0430\u0442\u0443\u044F
      \u0410\u043F\u043E\u043B\u043B\u043E\u043D\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443 \u043D\u0430\u0441 \u0440\u0443\u0445\u043D\u0443\u043B\u0430. \u041D\u0435
      \u043A \u0434\u043E\u0431\u0440\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969693
    m_Localized: "\u041A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u0434\u0430\u043D\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969694
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969695
    m_Localized: "\u041E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969696
    m_Localized: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043E \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6801039682969697
    m_Localized: "\u041F\u0440\u043E\u0444\u0438\u043B\u0438"
    m_Metadata:
