      m_Calls: []
  m_text: "\u042F \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C \u0421\u0442\u0430\u0440\u0448\u0438\u043C
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438 \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E,
    \u0447\u0442\u043E:\n\n\u042F \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E,
    \u0447\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
    \u0447\u0430\u0441\u0442\u044C\u044E \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438
    \u0438 \u0433\u043E\u0442\u043E\u0432(\u0430) \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u0437\u0430\u0434\u0430\u0447\u0438, \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
    \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E \u043D\u0430\u0448\u0435\u0439
    \u043A\u043E\u043C\u0430\u043D\u0434\u044B.\n\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0438\u0433\u0440\u043E\u0432\u043E\u0439
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0438 \u043E\u043D \u043D\u0443\u0436\u0435\u043D
    \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B."
