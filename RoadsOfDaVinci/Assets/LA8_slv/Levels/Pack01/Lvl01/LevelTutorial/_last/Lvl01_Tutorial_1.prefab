  m_text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043F\u0443\u0442\u044C \u043A
    \u043D\u0430\u0448\u0435\u0439 \u0446\u0435\u043B\u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442
    \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438.
    \u0414\u0430\u0432\u0430\u0439 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043C
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F,
