*.DotSettings.user

# Visual Studio
.vs/
.vsconfig

# Visual Studio Code (в проекте используется Rider)
.vscode/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

